# ------------------ Application ------------------
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# ------------------ Storage ------------------
MAX_FILE_SIZE_MB=50

# ------------------ Upload limits ------------------
MAX_FILES_PER_REQUEST=10
UPLOAD_CONCURRENCY=4

# ------------------ Chunking ------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ------------------ Embeddings & Vector Store ------------------
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16

# ------------------ Retrieval ------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_HYBRID=True

# ------------------ Memory ------------------
MEMORY_SHORT_TERM_N= 10
MEMORY_SUMMARY_EVERY_K= 6

# ------------------ LLM Generation ------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=_____put your Groq API key here from https://console.groq.com ok?_____

## if model is not set, see console.groq.com/docs/models
LLM_MODEL=llama-3.3-70b-versatile
LLM_CONTEXT_TOKEN_BUDGET=6000
LLM_TIMEOUT_S=60
