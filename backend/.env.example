# ------------------ Application ------------------
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# ------------------ Storage ------------------
MAX_FILE_SIZE_MB=50

# ------------------ Upload limits ------------------
MAX_FILES_PER_REQUEST=10
UPLOAD_RATE_LIMIT=10/hour
CHAT_RATE_LIMIT=30/minute
UPLOAD_CONCURRENCY=4

# ------------------ Chunking ------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ------------------ Embeddings & Vector Store ------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# ------------------ ARQ / Background Jobs ------------------
REDIS_URL=redis://localhost:6379
INGESTION_WORKER_MAX_JOBS=2
INGESTION_JOB_TIMEOUT_S=1800
INGESTION_MAX_TRIES=3

# ------------------ Retrieval ------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_HYBRID=True
RETRIEVAL_MIN_SCORE=0.0
QUERY_REWRITE_ENABLED=False

# ------------------ Memory ------------------
MEMORY_SHORT_TERM_N=10
MEMORY_SUMMARY_EVERY_K=6

# ------------------ LLM Generation ------------------
LLM_BASE_URL=https://api.groq.com/openai/v1

# Get your API key from https://console.groq.com
LLM_API_KEY=

LLM_MODEL=openai/gpt-oss-120b
LLM_CONTEXT_TOKEN_BUDGET=6000
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3

# ------------------ API ------------------
MAX_QUESTION_LENGTH=8000
CORS_ORIGINS=["http://localhost:3000"]
